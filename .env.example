# Copy to .env (or set in Vercel > Settings > Environment Variables)

# Required on Vercel. Locally, leave unset to use your Claude Code login instead.
ANTHROPIC_API_KEY=

# Required on Vercel (any long random string). Locally optional.
SESSION_SECRET=

# Postgres connection string. Vercel's Neon integration sets DATABASE_URL for you.
# Leave unset locally to use data/db.json.
DATABASE_URL=

# First-run admin account (defaults: admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional model override (e.g. claude-sonnet-5 on the API, "sonnet" for the Agent SDK)
AI_MODEL=
