# ---- Server (set these in Vercel > Settings > Environment Variables) ----

# Any long random string. Required on Vercel so logins work across instances.
SESSION_SECRET=

# Postgres connection string. Vercel's Neon integration sets DATABASE_URL for you.
# Leave unset locally to use data/db.json.
DATABASE_URL=

# First-run admin account (defaults: admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Local generator (generate.js) ----

# Where to publish generated homework, and the admin login to use.
HOMEWORK_URL=https://your-app.vercel.app
HOMEWORK_ADMIN_USER=admin
HOMEWORK_ADMIN_PASSWORD=

# Optional Claude model for generation, e.g. "sonnet" or "opus" (default: your Claude Code setting)
AI_MODEL=
